{
  "name": "mk-portfolio-web",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "seed:projects": "tsx scripts/export-projects.ts",
    "cf:dev": "npm run build && npx wrangler dev",
    "cf:deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^4.0.3",
    "@sanity/client": "^7.11.0",
    "@sanity/image-url": "^2.0.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

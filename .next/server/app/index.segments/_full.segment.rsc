d:[["$","section",null,{"className":"hero","id":"top","aria-labelledby":"hero-name","children":[["$","$L18",null,{}],["$","div",null,{"className":"hero-top","children":[["$","p",null,{"className":"hero-role mono muted","children":["Independent Web Engineer",["$","br",null,{}],"Belgrade, Serbia — Remote, CET"]}],["$","p",null,{"className":"hero-intro","children":["I build, migrate and run websites and web apps where engineering meets ",["$","em",null,{"children":"design"}]," — WordPress and Webflow, headless CMS on Next.js, and the CI/CD, hosting and SEO behind them."]}]]}],["$","div",null,{"children":[["$","h1",null,{"className":"hero-name","id":"hero-name","children":"Marko Kostić"}],["$","div",null,{"className":"hero-foot","children":[["$","ul",null,{"className":"mono muted","aria-label":"Core areas","children":[["$","li","9+ years",{"children":"9+ years"}],["$","li","WordPress",{"children":"WordPress"}],["$","li","Webflow",{"children":"Webflow"}],["$","li","Next.js",{"children":"Next.js"}],["$","li","Headless CMS",{"children":"Headless CMS"}],["$","li","CI/CD & hosting",{"children":"CI/CD & hosting"}],["$","li","Technical SEO",{"children":"Technical SEO"}]]}],["$","$Lb",null,{"className":"scroll-cue mono muted","href":"/#work","children":[["$","i",null,{"aria-hidden":"true"}],"Selected work"]}]]}]]}]]}],["$","section",null,{"className":"statement","aria-label":"Approach","children":[["$","p",null,{"id":"statement","children":["For nine years I've built websites for agencies and businesses across the US, EU, UK, Canada and the UAE — built properly, migrated safely, and kept ",["$","span",null,{"className":"serif","children":"fast, secure and findable"}]," long after launch."]}],["$","p",null,{"className":"sig mono muted","children":"Since 2017 — agencies, product teams, contract & freelance"}]]}],["$","$L19",null,{"projects":[{"slug":"zignify","name":"Zignify","hue":150,"mark":"Zi","featured":true,"tags":["WordPress","Automation","SEO"],"summary":"End-to-end ownership of the web stack — plus an AI content engine and programmatic SEO pages built on top of WordPress.","client":"Zignify — global product sourcing, quality control and logistics","engagement":"IT Consultant · Contract, Germany (remote)","period":"May 2025 — Present","role":"Web development, automation & SEO — sole technical owner","overview":"Zignify helps companies source products globally, handling quality control, logistics and shipping. I own their web stack end to end: domains, DNS, server administration and security, and full-stack WordPress development. On top of that foundation I build the systems that let a small marketing operation publish and rank at a scale that would normally need a much larger team.","challenge":"A sourcing business competes on visibility for a very wide range of product and market searches. Writing, formatting and publishing every article by hand doesn't scale, and hand-built landing pages drift out of date. The site needed to stay technically sound while content and pages were produced continuously — and the marketing side needed CRM and email automation that actually connected to the website.","approach":[{"title":"Own the foundation","description":"Took over domains, DNS, server administration and security so that every later automation runs on infrastructure I control and can troubleshoot directly."},{"title":"Turn tasks into published content","description":"Built a content engine where a ClickUp task becomes the brief: the system generates an SEO-ready article with AI assistance and publishes it to WordPress automatically, with no copy-paste step in between."},{"title":"Generate pages from data","description":"Developed programmatic SEO page systems that create and update large sets of landing pages from structured data, so pages are produced consistently and refreshed when the data changes."},{"title":"Keep it indexable","description":"Backed the volume with technical SEO — indexing control, schema markup and Core Web Vitals — so automated output stays crawlable and fast."},{"title":"Connect marketing","description":"Set up and connected GoHighLevel (CRM, funnels, workflows) and Klaviyo (email flows, segmentation) to the web stack."}],"delivered":["Domain, DNS, server administration and security — end to end","Full-stack WordPress development","ClickUp → AI → WordPress content automation engine","Programmatic SEO landing-page systems driven by structured data","Technical SEO: indexing, schema, Core Web Vitals","GoHighLevel CRM, funnels and workflows","Klaviyo email flows and segmentation"],"stack":["WordPress","PHP","ClickUp","AI automation","Programmatic SEO","Schema","GoHighLevel","Klaviyo","Linux server","DNS"],"outcome":null,"links":[{"label":"zignify.net","url":"https://zignify.net/"}]},{"slug":"idsa","name":"IDSA","hue":205,"mark":"ID","featured":true,"tags":["WordPress","Migration"],"summary":"Drupal to WordPress migration for the Infectious Diseases Society of America, with an ACF content architecture across 100+ pages.","client":"Infectious Diseases Society of America — medical association","engagement":"via newtarget, inc. (Washington, DC) — part of the development team","period":"During 2020 — 2023","role":"Web Developer & DevOps Engineer","overview":"IDSA is a medical association representing physicians, scientists and other healthcare professionals who specialise in infectious diseases. Its website is a large, content-heavy resource for members and the public. Working on the newtarget team, I took part in moving the site from Drupal to WordPress and in designing the content structure it now runs on.","challenge":"Migrating a large, established site between CMSs is never a straight copy. Drupal and WordPress model content differently, so structured content has to be re-mapped rather than pasted; editors need a system they can manage without breaking layouts; and 100+ pages have to arrive intact. The new architecture had to make the site easier to maintain, not just different.","approach":[{"title":"Model the content first","description":"Defined an ACF-based content architecture — structured fields and reusable layouts instead of free-form pages — so content is consistent across the site and editors work with clear inputs."},{"title":"Build the templates on that model","description":"Implemented custom WordPress templates that render the structured content, keeping presentation and data separate."},{"title":"Migrate and verify","description":"Moved 100+ pages from Drupal into the new structure and checked them against the source."},{"title":"Ship through the pipeline","description":"Supported deployment through newtarget's DevOps setup — CI/CD pipelines, deployments and security updates."}],"delivered":["Drupal → WordPress migration","ACF content architecture","100+ pages migrated into structured content","Custom WordPress templates","Deployment and DevOps support"],"stack":["WordPress","Drupal","ACF","PHP","CI/CD"],"outcome":["100+ pages migrated from Drupal to WordPress"],"links":[{"label":"www.idsociety.org","url":"https://www.idsociety.org/"}]},{"slug":"lumina-lumiere","name":"Lumina Lumière Institute","hue":40,"mark":"Lu","featured":true,"tags":["Next.js","Automation","SEO"],"summary":"An online course and membership platform built in Next.js — programs, lessons, video and member accounts, from setup to launch.","client":"Lumina Lumière Institute — education, Serbia","engagement":"Freelance · end-to-end ownership","period":"Between 2023 — 2026","role":"Full-stack developer — setup to launch and handover","overview":"Lumina Lumière Institute needed a platform where members sign in, follow programs and watch lessons. I built it in Next.js and owned the project from first setup through launch, then handed it over for ongoing maintenance.","challenge":"A course platform is several products at once: a content structure (programs → lessons → video), an account system for members, a marketing site that has to be found, and the email and tracking that turn visitors into students. All of it had to ship together and stay easy to deploy.","approach":[{"title":"Structure the learning content","description":"Modelled programs and lessons with video as structured content."},{"title":"Member accounts","description":"Built member accounts for the membership side of the platform."},{"title":"Automate delivery","description":"Set up automated Vercel deployments so every change ships the same way."},{"title":"Connect the funnel","description":"Integrated MailerLite automations for email, plus GA4 and Meta Pixel tracking for measurement."},{"title":"Be findable — by search and by AI","description":"Implemented SEO and AEO/GEO optimisation so the platform is discoverable in classic search and in AI-generated answers."}],"delivered":["Next.js course and membership platform","Programs, lessons and video content structure","Member accounts","Automated Vercel deployments","MailerLite automations","GA4 and Meta Pixel tracking","SEO and AEO/GEO optimisation","Launch and structured handover for maintenance"],"stack":["Next.js","React","Vercel","MailerLite","GA4","Meta Pixel"],"outcome":["Launched and handed over for ongoing maintenance"],"links":[]},{"slug":"mc-adventure","name":"MC Adventure","hue":24,"mark":"MC","featured":true,"tags":["WordPress","WooCommerce"],"summary":"A fully custom WordPress and WooCommerce theme with a booking system built from scratch for an outdoor adventure company in Malta.","client":"MC Adventure — outdoor adventure sports, Malta","engagement":null,"period":null,"role":"Theme and booking system development","overview":"MC Adventure runs guided outdoor activities in Malta — climbing, kayaking, abseiling, ziplines and more. Their shop needed to sell experiences, not just products, so I built a fully custom WordPress and WooCommerce theme and a booking system written from scratch.","challenge":"WooCommerce is designed around products in a cart. Experiences behave differently: they are booked rather than shipped. Instead of bending a generic booking plugin to fit, the booking logic was built specifically for how MC Adventure sells.","approach":[{"title":"A theme built for this brand","description":"Developed a fully custom WordPress/WooCommerce theme rather than adapting an off-the-shelf one, so layout and checkout follow the business instead of a template."},{"title":"Booking logic from scratch","description":"Wrote the booking system from the ground up on top of WooCommerce, so activities are booked through the same store and checkout."}],"delivered":["Fully custom WordPress and WooCommerce theme","Booking system developed from scratch","Front-end implementation"],"stack":["WordPress","WooCommerce","PHP","JavaScript","Custom theme"],"outcome":null,"links":[{"label":"shop.mcadventure.com.mt","url":"https://shop.mcadventure.com.mt/"}]},{"slug":"social-hype","name":"Social Hype","hue":330,"mark":"SH","featured":true,"tags":["WordPress","WooCommerce","Webflow","SEO"],"summary":"Led all web development for a digital marketing agency in Toronto and Dubai — its own sites and its clients', in WordPress and Webflow.","client":"Social Hype — digital marketing agency, Toronto & Dubai","engagement":"IT Consultant – Lead Web Developer · Contract (completed)","period":"Mar 2025 — Sep 2026","role":"Lead web developer — scoping, build, launch, handover","overview":"Social Hype is a digital marketing agency working with clients in Canada and the UAE through SEO, paid ads, websites and social media. I led all of its web development: the agency's own Canadian and UAE websites, and the client sites it delivered, with end-to-end ownership from scoping to handover.","challenge":"An agency's web work is a portfolio, not a single project: different clients, two markets, two platforms (WordPress and Webflow), and a marketing team that depends on accurate tracking. The job was to make delivery repeatable — consistent builds, reliable performance and clean handovers — while staying the technical point of contact for clients and marketers.","approach":[{"title":"Agency sites from Figma","description":"Built socialhype.ca and socialhype.ae from Figma designs in WordPress with Elementor."},{"title":"A delivery process","description":"Ran client projects end to end — scoping, build, launch and a structured handover for ongoing maintenance."},{"title":"Right platform per client","description":"Built and maintained WordPress (Elementor, WooCommerce) sites, and Webflow sites from Figma with CMS collections, Interactions and animations, SEO settings and client handover."},{"title":"Measure everything","description":"Owned performance, technical SEO and tracking across the portfolio: Core Web Vitals, schema, GA4, GTM and Meta Pixel."},{"title":"Run the infrastructure","description":"Managed hosting, DNS, SSL and deployments for the portfolio."}],"delivered":["socialhype.ca and socialhype.ae — Figma to WordPress (Elementor)","Client websites in WordPress, Elementor and WooCommerce","Client websites in Webflow — CMS, Interactions, animations, SEO","Performance and technical SEO across the portfolio","GA4, GTM, Meta Pixel and schema implementation","Hosting, DNS, SSL and deployments","Technical point of contact for clients and the marketing team"],"stack":["WordPress","Elementor Pro","WooCommerce","Webflow","Figma","GA4","GTM","Meta Pixel","Schema"],"outcome":["Contract completed with structured handover for ongoing maintenance"],"links":[{"label":"socialhype.ca","url":"https://socialhype.ca/"},{"label":"socialhype.ae","url":"https://socialhype.ae/"}]},{"slug":"swan-learning-center","name":"Swan Learning Center","hue":200,"mark":"Sw","featured":true,"tags":["WordPress","Migration","Automation","SEO"],"summary":"Full migration and rebuild from Wix to WordPress, with CRM-connected lead tracking and an SEO migration that preserved rankings.","client":"Swan Learning Center — tutoring and test prep, Charlotte, NC, USA","engagement":"Freelance","period":"Between 2023 — 2026, ongoing maintenance","role":"Migration, rebuild, integrations and maintenance","overview":"Swan Learning Center is a tutoring centre in Charlotte, North Carolina, offering reading, writing, maths, test preparation and summer programs. Its site ran on Wix. I migrated and rebuilt it in WordPress with Elementor, wired its enquiry forms into the CRMs the team uses, and planned the SEO side of the move so the switch wouldn't cost them search visibility.","challenge":"For a local education business the website is the main source of enquiries, so a platform change carries real risk: every old URL that stops resolving loses search equity, and every form that isn't tracked is a lead nobody follows up. The rebuild had to improve the platform without breaking either.","approach":[{"title":"Plan the SEO migration first","description":"Planned the SEO migration around a 301 redirect map from the old Wix URLs to their new WordPress equivalents."},{"title":"Rebuild in WordPress","description":"Rebuilt the site in WordPress and Elementor so the team can maintain it themselves."},{"title":"Close the lead loop","description":"Connected the site's forms to HubSpot and GoHighLevel for lead tracking and follow-up."},{"title":"Measure conversions","description":"Set up external conversion measurement so enquiries can be attributed."},{"title":"Stay on","description":"Continued with ongoing website maintenance after launch."}],"delivered":["Full Wix → WordPress migration and rebuild","Elementor build","SEO migration plan with 301 redirects","HubSpot and GoHighLevel form integrations","External conversion measurement","Ongoing maintenance"],"stack":["WordPress","Elementor","Wix (source)","HubSpot","GoHighLevel","301 redirects"],"outcome":["Search rankings preserved through the migration"],"links":[{"label":"www.swanlearningcenter.com","url":"https://www.swanlearningcenter.com/"}]},{"slug":"ses-intelsat","name":"Intelsat (now SES)","hue":220,"mark":"In","featured":true,"tags":["WordPress"],"summary":"Custom Gutenberg blocks, front-end development, support and deployment for the website of a global satellite operator.","client":"Intelsat — global satellite operator, now part of SES","engagement":null,"period":null,"role":"Gutenberg block development, front end, support, deployment","overview":"Intelsat is a global satellite operator; in July 2025 it became part of SES. I worked on the Intelsat website, building custom Gutenberg blocks and front-end components, and supporting deployments and ongoing changes.","challenge":"A corporate site at this level is edited by communications teams, not developers. Content needs to look on-brand every time it is published, without designers checking each page. Custom blocks are how you give editors flexibility and keep the layout under control.","approach":[{"title":"Blocks as a design system","description":"Built custom Gutenberg blocks that encode the site's layouts and components, so editors assemble pages from approved pieces."},{"title":"Front-end implementation","description":"Implemented the front end of those components."},{"title":"Support and deploy","description":"Provided ongoing support and handled deployments."}],"delivered":["Custom Gutenberg blocks","Front-end development","Ongoing support","Deployment"],"stack":["WordPress","Gutenberg","PHP","JavaScript","SCSS"],"outcome":null,"links":[{"label":"www.ses.com","url":"https://www.ses.com/"}]}]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]

1a:["$","$L22",null,{"projects":["$d:2:props:projects:0","$d:2:props:projects:1","$d:2:props:projects:2","$d:2:props:projects:3","$d:2:props:projects:4","$d:2:props:projects:5","$d:2:props:projects:6",{"slug":"osenity","name":"Osenity","hue":12,"mark":"Os","featured":false,"tags":["WordPress","WooCommerce"],"summary":"A fully custom WooCommerce bookstore — product import add-on, advanced catalogue filtering and a payment gateway for Balkan markets.","client":"Osenity — online bookstore, Serbia","engagement":"Freelance · end-to-end ownership","period":"Between 2023 — 2026","role":"Lead developer — setup to launch, mentoring a junior developer","overview":"Osenity sells books online in Serbia. I built the store as a fully custom WooCommerce project and owned it from setup to launch, then handed it over for ongoing maintenance. Along the way I mentored a junior developer on the team.","challenge":"Bookstores have very different needs from a typical shop: lots of products with rich metadata, readers who search by more than price, and — in the Balkans — local payment options. Each of those needed custom work.","approach":[{"title":"Get the catalogue in","description":"Built a product import add-on so the catalogue can be loaded into WooCommerce instead of being entered by hand."},{"title":"Help readers find books","description":"Implemented advanced catalogue filtering on top of WooCommerce."},{"title":"Pay the local way","description":"Integrated a payment gateway for Balkan markets."},{"title":"Grow the team","description":"Mentored a junior developer during the build."}],"delivered":["Fully custom WooCommerce bookstore","Product import add-on","Advanced catalogue filtering","Payment gateway for Balkan markets","Junior developer mentoring","Launch and structured handover"],"stack":["WordPress","WooCommerce","PHP","Custom plugin","Payment gateway"],"outcome":["Launched and handed over for ongoing maintenance"],"links":[]},{"slug":"diamond-rose-sanctuary","name":"Diamond Rose Sanctuary","hue":345,"mark":"Dr","featured":false,"tags":["Webflow"],"summary":"A Figma to Webflow redesign with front-end build, animations and ongoing maintenance.","client":null,"engagement":null,"period":null,"role":"Webflow development — redesign, front end, animations, maintenance","overview":"A redesign delivered in Webflow: I took the new design from Figma into a production Webflow site, built the front end and its animations, and continued to maintain it.","challenge":"Redesigns in Webflow live or die on how faithfully the Figma design survives the build — spacing, type and motion — while staying editable by the client afterwards.","approach":[{"title":"Figma to Webflow","description":"Translated the Figma redesign into a structured Webflow build."},{"title":"Motion","description":"Implemented the site's animations with Webflow Interactions."},{"title":"Maintain","description":"Stayed on for maintenance after launch."}],"delivered":["Figma → Webflow redesign","Front-end development","Animations","Maintenance"],"stack":["Webflow","Figma","Webflow Interactions"],"outcome":null,"links":[{"label":"diamondrosesanctuary.com","url":"https://diamondrosesanctuary.com/"}]},{"slug":"kudanil","name":"Kudanil","hue":95,"mark":"Ku","featured":false,"tags":["Webflow","SEO"],"summary":"A Figma to Webflow build, including SEO setup, DNS and domain configuration, and maintenance.","client":null,"engagement":null,"period":null,"role":"Webflow build, SEO, domain and DNS, maintenance","overview":"A complete Webflow launch: from the Figma design to a live site, including the parts that usually fall between designer and client — SEO configuration, domain and DNS — followed by ongoing maintenance.","challenge":"Getting a site live involves more than the build. Domain, DNS and SEO settings are often where launches stall; owning them made the handoff from design to a working, indexable site a single responsibility.","approach":[{"title":"Build from Figma","description":"Implemented the Figma design in Webflow."},{"title":"Set up for search","description":"Configured SEO settings for launch."},{"title":"Go live","description":"Handled DNS and domain setup."},{"title":"Maintain","description":"Continued with maintenance after launch."}],"delivered":["Figma → Webflow build","SEO setup","DNS and domain setup","Maintenance"],"stack":["Webflow","Figma","DNS"],"outcome":null,"links":[{"label":"kudanil.com","url":"https://kudanil.com/"}]},{"slug":"aprico","name":"Aprico","hue":30,"mark":"Ap","featured":false,"tags":["WordPress","WooCommerce","SEO"],"summary":"A custom WooCommerce theme and templates, with SEO, speed, security and ADA accessibility fixes.","client":"Aprico — e-commerce","engagement":null,"period":null,"role":"Theme development, optimisation and accessibility","overview":"For Aprico I built a custom WooCommerce theme and templates, then worked on the qualities that decide whether a store performs: search visibility, speed, security and accessibility.","challenge":"An online store has to be fast, findable, safe and usable by everyone. Accessibility in particular is easy to break in custom themes, and fixing ADA issues after the fact means going through templates carefully.","approach":[{"title":"Custom theme","description":"Developed a custom WooCommerce theme and custom templates."},{"title":"Optimise","description":"Worked on SEO and speed optimisation."},{"title":"Accessibility","description":"Fixed ADA accessibility issues across the site."},{"title":"Keep it safe","description":"Applied security updates."}],"delivered":["Custom WooCommerce theme","Custom template development","Front-end development","SEO optimisation","Speed optimisation","ADA accessibility fixes","Security updates"],"stack":["WordPress","WooCommerce","PHP","JavaScript"],"outcome":null,"links":[{"label":"www.aprico.life","url":"https://www.aprico.life/"}]},{"slug":"mitsubishi-electric","name":"Mitsubishi Electric","hue":0,"mark":"Me","featured":false,"tags":["WordPress"],"summary":"Reusable templates, front-end development and DevOps support.","client":"Mitsubishi Electric site at kencar.net","engagement":null,"period":null,"role":"Templates, front end, DevOps support","overview":"I built custom, reusable templates and front-end components for this Mitsubishi Electric site, and supported it on the DevOps side.","challenge":"Reusable templates mean new pages can be produced from the same well-built parts, rather than one-off layouts that are hard to maintain.","approach":[{"title":"Reusable templates","description":"Built custom templates designed to be reused across pages."},{"title":"Front end","description":"Implemented the front-end development."},{"title":"DevOps support","description":"Supported deployment and operations."}],"delivered":["Custom and reusable templates","Front-end development","DevOps support"],"stack":null,"outcome":null,"links":[{"label":"mitsubishielectric.kencar.net","url":"https://mitsubishielectric.kencar.net/"}]},{"slug":"septeni-global","name":"Septeni Global","hue":355,"mark":"Se","featured":false,"tags":["Custom code"],"summary":"A fully custom-coded website with animations, multilingual support and a blog integration.","client":"Septeni Global — corporate website","engagement":null,"period":null,"role":"Custom development, animations, multilingual, blog integration","overview":"Septeni Global's site was coded by hand rather than built on a theme. I developed it with custom animations and multilingual support, and integrated it with a separate blog running on Wix.","challenge":"Two platforms, several languages, one brand: the custom site and the Wix-hosted blog had to feel like one experience.","approach":[{"title":"Custom code","description":"Built the website as a fully custom-coded project."},{"title":"Motion","description":"Implemented the site's animations."},{"title":"Multilingual","description":"Integrated multilingual support."},{"title":"Blog integration","description":"Connected the site with its blog on the Wix platform at blog.septeniglobal.com."}],"delivered":["Fully custom-coded website","Animations","Multilingual integration","Blog integration with Wix"],"stack":["HTML","CSS","JavaScript","Wix (blog)"],"outcome":null,"links":[{"label":"septeniglobal.com","url":"https://www.septeniglobal.com/"},{"label":"blog.septeniglobal.com","url":"https://www.blog.septeniglobal.com/"}]},{"slug":"jdh-capital","name":"JDH Capital","hue":45,"mark":"JD","featured":false,"tags":["WordPress"],"summary":"Custom theme and template development.","client":"JDH Capital","engagement":null,"period":null,"role":"Custom theme and templates","overview":"For JDH Capital I developed a custom WordPress theme and its templates.","challenge":null,"approach":[{"title":"Custom theme","description":"Developed a custom theme for the site."},{"title":"Templates","description":"Built the page templates on top of it."}],"delivered":["Custom theme development","Template development"],"stack":["WordPress","PHP"],"outcome":null,"links":[{"label":"www.jdhcap.com","url":"https://www.jdhcap.com/"}]},{"slug":"summit-sre","name":"Summit SRE","hue":190,"mark":"Su","featured":false,"tags":["WordPress"],"summary":"Custom Elementor template kits, animations and speed optimisation.","client":"Summit SRE","engagement":null,"period":null,"role":"Elementor template kits, animations, performance","overview":"I built custom Elementor template kits for Summit SRE — reusable sets of layouts the team can build pages from — together with the site's animations, and optimised it for speed.","challenge":"Page builders make sites easy to edit and easy to slow down. Template kits keep pages consistent; performance work keeps the builder output fast.","approach":[{"title":"Template kits","description":"Built custom Elementor template kits for consistent, reusable layouts."},{"title":"Motion","description":"Implemented animations."},{"title":"Speed","description":"Optimised the site for speed."}],"delivered":["Custom Elementor template kits","Animations","Speed optimisation"],"stack":["WordPress","Elementor"],"outcome":null,"links":[{"label":"summitsre.com","url":"https://summitsre.com/"}]},{"slug":"cz-finance","name":"CZ Finance","hue":160,"mark":"CZ","featured":false,"tags":["WordPress","SEO"],"summary":"A custom Elementor-based theme with speed and SEO optimisation.","client":"CZ Finance","engagement":null,"period":null,"role":"Theme development, speed and SEO","overview":"For CZ Finance I built a custom theme based on Elementor and optimised the site for speed and search.","challenge":null,"approach":[{"title":"Custom Elementor theme","description":"Built a custom theme on top of Elementor."},{"title":"Speed","description":"Optimised loading performance."},{"title":"SEO","description":"Implemented SEO optimisation."}],"delivered":["Custom theme based on Elementor","Speed optimisation","SEO optimisation"],"stack":["WordPress","Elementor"],"outcome":null,"links":[{"label":"cz.finance","url":"https://cz.finance/"}]},{"slug":"santos-digital","name":"Santos Digital","hue":260,"mark":"SD","featured":false,"tags":["WordPress"],"summary":"Front-end rebuild of a Belgrade web agency's main website, plus ongoing maintenance.","client":"Santos Digital — WordPress-focused web agency, Belgrade","engagement":"Freelance","period":"Between 2023 — 2026","role":"Front-end rebuild and maintenance","overview":"Santos Digital is a Belgrade web agency focused on WordPress. I rebuilt the front end of the agency's main website and continued maintaining it afterwards.","challenge":"An agency's own website is its portfolio piece — it has to show the standard the agency sells.","approach":[{"title":"Front-end rebuild","description":"Rebuilt the front end of the agency's main website."},{"title":"Maintenance","description":"Provided ongoing maintenance."}],"delivered":["Front-end rebuild","Ongoing maintenance"],"stack":["WordPress"],"outcome":null,"links":[]},{"slug":"newtarget","name":"newtarget","hue":230,"mark":"nt","featured":false,"tags":["WordPress","SEO"],"summary":"Front-end development, SEO optimisation and security updates for the agency's own website.","client":"newtarget, inc. — digital agency, Washington, DC","engagement":"Full-time · Web Developer & DevOps Engineer","period":"During 2020 — 2023","role":"Front end, SEO, security","overview":"Besides client work at newtarget, I worked on the agency's own website: front-end development, SEO optimisation and security updates.","challenge":null,"approach":[{"title":"Front end","description":"Front-end development of the agency site."},{"title":"SEO","description":"SEO optimisation."},{"title":"Security","description":"Security updates."}],"delivered":["Front-end development","SEO optimisation","Security updates"],"stack":["WordPress"],"outcome":null,"links":[{"label":"www.newtarget.com","url":"https://www.newtarget.com/"}]}]}]

17:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"Overview"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"className":"cs-lead","children":"IDSA is a medical association representing physicians, scientists and other healthcare professionals who specialise in infectious diseases. Its website is a large, content-heavy resource for members and the public. Working on the newtarget team, I took part in moving the site from Drupal to WordPress and in designing the content structure it now runs on."}]}]]}]
18:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"The challenge"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"children":"Migrating a large, established site between CMSs is never a straight copy. Drupal and WordPress model content differently, so structured content has to be re-mapped rather than pasted; editors need a system they can manage without breaking layouts; and 100+ pages have to arrive intact. The new architecture had to make the site easier to maintain, not just different."}]}]]}]
19:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"Approach"}],["$","div",null,{"className":"cs-body","children":["$","ol",null,{"className":"steps","children":[["$","li","Model the content first",{"children":[["$","h3",null,{"children":"Model the content first"}],["$","p",null,{"children":"Defined an ACF-based content architecture — structured fields and reusable layouts instead of free-form pages — so content is consistent across the site and editors work with clear inputs."}]]}],["$","li","Build the templates on that model",{"children":[["$","h3",null,{"children":"Build the templates on that model"}],["$","p",null,{"children":"Implemented custom WordPress templates that render the structured content, keeping presentation and data separate."}]]}],["$","li","Migrate and verify",{"children":[["$","h3",null,{"children":"Migrate and verify"}],["$","p",null,{"children":"Moved 100+ pages from Drupal into the new structure and checked them against the source."}]]}],["$","li","Ship through the pipeline",{"children":[["$","h3",null,{"children":"Ship through the pipeline"}],["$","p",null,{"children":"Supported deployment through newtarget's DevOps setup — CI/CD pipelines, deployments and security updates."}]]}]]}]}]]}]

16:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"Overview"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"className":"cs-lead","children":"Social Hype is a digital marketing agency working with clients in Canada and the UAE through SEO, paid ads, websites and social media. I led all of its web development: the agency's own Canadian and UAE websites, and the client sites it delivered, with end-to-end ownership from scoping to handover."}]}]]}]
17:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"The challenge"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"children":"An agency's web work is a portfolio, not a single project: different clients, two markets, two platforms (WordPress and Webflow), and a marketing team that depends on accurate tracking. The job was to make delivery repeatable — consistent builds, reliable performance and clean handovers — while staying the technical point of contact for clients and marketers."}]}]]}]

15:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"Overview"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"className":"cs-lead","children":"Zignify helps companies source products globally, handling quality control, logistics and shipping. I own their web stack end to end: domains, DNS, server administration and security, and full-stack WordPress development. On top of that foundation I build the systems that let a small marketing operation publish and rank at a scale that would normally need a much larger team."}]}]]}]
16:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"The challenge"}],["$","div",null,{"className":"cs-body","children":["$","p",null,{"children":"A sourcing business competes on visibility for a very wide range of product and market searches. Writing, formatting and publishing every article by hand doesn't scale, and hand-built landing pages drift out of date. The site needed to stay technically sound while content and pages were produced continuously — and the marketing side needed CRM and email automation that actually connected to the website."}]}]]}]
17:["$","section",null,{"className":"cs-sec","children":[["$","h2",null,{"className":"mono","children":"Approach"}],["$","div",null,{"className":"cs-body","children":["$","ol",null,{"className":"steps","children":[["$","li","Own the foundation",{"children":[["$","h3",null,{"children":"Own the foundation"}],["$","p",null,{"children":"Took over domains, DNS, server administration and security so that every later automation runs on infrastructure I control and can troubleshoot directly."}]]}],["$","li","Turn tasks into published content",{"children":[["$","h3",null,{"children":"Turn tasks into published content"}],["$","p",null,{"children":"Built a content engine where a ClickUp task becomes the brief: the system generates an SEO-ready article with AI assistance and publishes it to WordPress automatically, with no copy-paste step in between."}]]}],["$","li","Generate pages from data",{"children":[["$","h3",null,{"children":"Generate pages from data"}],["$","p",null,{"children":"Developed programmatic SEO page systems that create and update large sets of landing pages from structured data, so pages are produced consistently and refreshed when the data changes."}]]}],["$","li","Keep it indexable",{"children":[["$","h3",null,{"children":"Keep it indexable"}],["$","p",null,{"children":"Backed the volume with technical SEO — indexing control, schema markup and Core Web Vitals — so automated output stays crawlable and fast."}]]}],["$","li","Connect marketing",{"children":[["$","h3",null,{"children":"Connect marketing"}],["$","p",null,{"children":"Set up and connected GoHighLevel (CRM, funnels, workflows) and Klaviyo (email flows, segmentation) to the web stack."}]]}]]}]}]]}]

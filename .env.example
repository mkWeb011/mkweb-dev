# Copy to .env.local and fill in. NEXT_PUBLIC_* values end up in the browser
# bundle — that is fine here: project ID and dataset are public identifiers.
# Never put a write token in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SITE_URL=https://markokostic.dev
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
